# ── Aplikasi ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────
# PGlite = Postgres in-process (WASM). Butuh nol install.
# Untuk produksi, isi DATABASE_URL dan set DB_DRIVER=postgres (lihat README § Deployment).
DB_DRIVER=pglite
PGLITE_DATA_DIR=./storage/pgdata
# DATABASE_URL=postgresql://user:password@localhost:5432/spk_bansos

# ── Auth ─────────────────────────────────────────────────────────────────
# WAJIB >= 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter-panjang
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=10

# ── CORS ─────────────────────────────────────────────────────────────────
# Pemisah koma untuk banyak origin.
CORS_ORIGIN=http://localhost:5173

# ── Identitas laporan resmi ────────────────────────────────────────────
# Nama desa untuk kop laporan PDF. Kosongkan? Jangan: isi nama sebenarnya,
# karena dokumen resmi tidak boleh mencantumkan nama karangan.
NAMA_DESA=Desa

# ── Upload dokumen verifikasi ────────────────────────────────────────────
UPLOAD_DIR=./storage/verifikasi
MAX_UPLOAD_MB=5

# ── WASPAS ───────────────────────────────────────────────────────────────
# Lambda default: 0.5 berarti WS dan WP diberi bobot sama.
WASPAS_LAMBDA_DEFAULT=0.5

# ── Email (opsional, nonaktif bila kosong) ───────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SPK Bansos <noreply@desa.go.id>
