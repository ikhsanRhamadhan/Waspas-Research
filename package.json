{
  "name": "spk-bansos",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Pendukung Keputusan Penerimaan Bantuan Sosial Berbasis Verifikasi Data Berlapis dan Metode WASPAS",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @spk-bansos/api",
    "dev:web": "npm run dev --workspace @spk-bansos/web",
    "build": "npm run build --workspace @spk-bansos/api && npm run build --workspace @spk-bansos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @spk-bansos/api",
    "db:migrate": "npm run db:migrate --workspace @spk-bansos/api",
    "db:seed": "npm run db:seed --workspace @spk-bansos/api",
    "db:reset": "npm run db:reset --workspace @spk-bansos/api",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
